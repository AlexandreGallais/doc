# =============================================================================
# Dev container Electron — Linux, cible Windows (NSIS via Wine)
# + exécution d'Electron sur le compositeur Wayland de l'hôte
#   (socket Wayland partagé dans XDG_RUNTIME_DIR, voir devcontainer.json)
# =============================================================================
# Image de base : à remplacer par le proxy Docker Nexus
ARG BASE_IMAGE=node:26-trixie
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# -----------------------------------------------------------------------------
# 1) Runtime Electron (Chromium) + Wayland + Mesa + polices
#    Noms Debian 13 (trixie) : suffixe t64 pour atk, cups, asound, gtk, atspi
# -----------------------------------------------------------------------------
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libnss3 libnspr4 \
      libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64 \
      libcups2t64 libasound2t64 libgtk-3-0t64 \
      libdrm2 libgbm1 libxkbcommon0 libxshmfence1 \
      libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libxss1 libxtst6 \
      libpango-1.0-0 libcairo2 libdbus-1-3 libnotify4 libsecret-1-0 \
      libwayland-client0 libwayland-cursor0 libwayland-egl1 \
      libegl1 libgl1-mesa-dri \
      xdg-utils adwaita-icon-theme \
      fonts-liberation fonts-dejavu-core fonts-noto-color-emoji \
      wayland-utils \
 && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 2) Cible Windows depuis Linux : Wine (génération de l'uninstaller NSIS)
#    Multiarch i386 obligatoire (l'installeur NSIS est un exe 32 bits)
# -----------------------------------------------------------------------------
RUN dpkg --add-architecture i386 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      wine wine32 wine64 libwine libwine:i386 fonts-wine \
 && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# 3) Environnement
#    XDG_RUNTIME_DIR et WINEPREFIX sont dans le home de "node" :
#    updateRemoteUserUID fait un chown -R du home → ils suivent l'UID de l'hôte.
# -----------------------------------------------------------------------------
ENV XDG_RUNTIME_DIR=/home/node/.xdg-runtime \
    XDG_SESSION_TYPE=wayland \
    WINEPREFIX=/home/node/.wine \
    WINEDEBUG=-all,err+all \
    WINEDLLOVERRIDES=winemenubuilder.exe=d

USER node

# XDG_RUNTIME_DIR : doit exister, appartenir à l'utilisateur, mode 0700
RUN mkdir -p "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"

# Pré-initialisation du préfixe Wine (optionnel : accélère le 1er build Windows)
# mscoree/mshtml désactivés → pas de demande d'installation Mono/Gecko
RUN WINEDLLOVERRIDES="mscoree,mshtml=;winemenubuilder.exe=d" wine wineboot --init || true
