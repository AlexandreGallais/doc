  ELECTRON_BUILDER_BINARIES_MIRROR: "https://nexus.local/repository/github/electron-userland/electron-builder-binaries/releases/download/"

.electron-cache-linux: &electron-cache-linux
  variables:
    XDG_CACHE_HOME: "$CI_PROJECT_DIR/.cache"
  cache:
    key: electron-linux
    paths: [.cache/electron, .cache/electron-builder]

build:linux:
  <<: *electron-cache-linux
  image: nexus.local/docker/electron-ci-linux:node26
  script:
    - npm ci
    - npx electron-builder --linux AppImage deb rpm --x64 --publish never
  artifacts:
    paths: [dist/*.AppImage, dist/*.deb, dist/*.rpm]

build:windows-from-linux:
  <<: *electron-cache-linux
  image: nexus.local/docker/electron-ci-linux-wine:node26
  script:
    - npm ci
    - npx electron-builder --win nsis --x64 --publish never
  artifacts:
    paths: [dist/*.exe]

build:windows-native:
  tags: [windows]          # runner GitLab Windows, executor docker-windows
  image: nexus.local/docker/electron-ci-windows:ltsc2022-node26
  script:
    - npm ci
    - npx electron-builder --win nsis --x64 --publish never
  artifacts:
    paths: [dist/*.exe]
```

